rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny-All Catch-All (Pillar 1 / Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    // User profile document and subcollections
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId);

      // Tasks subcollection: synced across all user devices in real time
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == userId;
        allow update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == userId;
        allow update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Habits subcollection
      match /habits/{habitId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == userId;
        allow update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }

      // Countdowns subcollection
      match /countdowns/{countdownId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().userId == userId;
        allow update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
